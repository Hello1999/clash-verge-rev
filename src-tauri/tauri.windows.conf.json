{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clash Verge Auto Chain",
  "version": "2.5.14",
  "mainBinaryName": "clash-verge-auto-chain",
  "identifier": "io.github.hello1999.clash-verge-auto-chain",
  "build": {
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src-tauri/packages/windows/claude-guard/build.ps1 && pnpm run web:build"
  },
  "bundle": {
    "publisher": "Clash Verge Auto Chain",
    "shortDescription": "Clash Verge Auto Chain",
    "longDescription": "Personal Windows build with automatic proxy chaining and an independent application identity.",
    "resources": [
      "resources/ASN.mmdb",
      "resources/Country.mmdb",
      "resources/geoip.dat",
      "resources/geosite.dat",
      "resources/enableLoopback.exe",
      "resources/clash-verge-service-auto-chain.exe",
      "resources/clash-verge-service-install.exe",
      "resources/clash-verge-service-uninstall.exe",
      "resources/claude-guard-manager.exe",
      "packages/windows/claude-guard/reconcile.ps1"
    ],
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English", "Russian"],
        "installMode": "perMachine",
        "installerHooks": "./packages/windows/core-hashes.nsh",
        "template": "./packages/windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["clash-verge-auto-chain"]
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "desktop-capability",
        "desktop-windows-capability",
        "migrated"
      ]
    }
  }
}
